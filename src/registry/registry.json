{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "items": [
    {
      "name": "charts-core",
      "type": "registry:lib",
      "title": "Charts Core",
      "description": "Shared chart primitives: colour tokens, series helpers, slots, and the ECharts tooltip, legend, dot, brush and paint modules. Installed automatically by every chart.",
      "dependencies": [
        "echarts",
        "solid-js"
      ],
      "files": [
        {
          "path": "lib/chart-background.tsx",
          "type": "registry:lib",
          "target": "components/solid-charts/lib/chart-background.tsx"
        },
        {
          "path": "lib/chart-series.ts",
          "type": "registry:lib",
          "target": "components/solid-charts/lib/chart-series.ts"
        },
        {
          "path": "lib/chart-tokens.ts",
