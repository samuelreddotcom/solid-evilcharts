{
  "name": "solid-evilcharts",
  "version": "0.0.0",
  "private": true,
  "description": "Static, beautifully designed charts for SolidJS, powered by Apache ECharts.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-seo.mts && tsc --noEmit",
    "registry:build": "node scripts/build-registry.mts",
    "serve": "vite preview",
    "start": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "seo:build": "node scripts/build-seo.mts",
    "og:build": "rsvg-convert -w 1200 -h 630 scripts/art/og.svg -o public/og.png && rsvg-convert -w 180 -h 180 public/favicon.svg -o public/apple-touch-icon.png"
  },
  "dependencies": {
    "@ark-ui/solid": "^5.37.0",
    "@tanstack/solid-router": "^1.131.35",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "lucide-solid": "^1.17.0",
    "solid-js": "^1.9.13",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@mdx-js/mdx": "3.1.1",
    "@mdx-js/rollup": "3.1.1",
    "@shikijs/rehype": "4.4.3",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/router-plugin": "^1.131.35",
    "@types/node": "^22.10.2",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "jsdom": "^25.0.1",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "rehype-slug": "6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "shiki": "4.4.3",
    "solid-devtools": "^0.34.5",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^5.0.0"
  }
}
