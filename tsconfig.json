{
  "compilerOptions": {
    // General
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "target": "ES2022",

    // Modules
    "module": "preserve",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    // verbatimModuleSyntax is deliberately OFF. It buys style, not safety, and
    // solid-foundation-design-system doesn't use it — enabling it here would
    // force an edit into every vendored component and guarantee drift.
    "paths": { "~/*": ["./src/*"] },

    // Type Checking & Safety
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,

    "types": ["vite/client", "node"]
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts", "vitest.setup.ts"]
}
