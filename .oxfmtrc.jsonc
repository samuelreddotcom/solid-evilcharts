{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",

  // Measured, not chosen by taste: formatting HEAD at widths from 80 to 110 and
  // counting the files that change bottoms out flat at 90–92 (74 files) and
  // climbs either side — 99 files at 80, 87 at 100. 90 is the width this code
  // was already closest to being written at.
  //
  // Note it does not reach zero at ANY width, because the repo has never been
  // machine-formatted: some JSX is written past 90 and gets wrapped, while other
  // calls are hand-split narrow and get joined. One deliberate `npm run fmt`
  // pass is what makes `fmt:check` a no-op; this setting only decides where it
  // lands. See README, "Formatting".
  "printWidth": 90,

  // oxfmt formats far more than TypeScript, and left unscoped it rewrites three
  // kinds of file that are deliberately hand-maintained here:
  //
  //   .mdx   pads every table and rewrites *emphasis* to _emphasis_, across all
  //          15 docs pages
  //   .css   reflows styles.css, which is kept token-for-token identical to
  //          upstream EvilCharts so snippets copy in either direction
  //   .json  includes src/registry/registry.json, which is GENERATED by
  //          scripts/build-registry.mts. registry.test.ts compares the committed
  //          file against the generator's output, so formatting it turns `npm
  //          test` red until the generator is re-run — a genuinely confusing
  //          failure, since nothing in the source changed.
  //
  // Generated TypeScript needs no entry: oxfmt reads .gitignore by default, and
  // src/routeTree.gen.ts is already listed there.
  "ignorePatterns": ["**/*.mdx", "**/*.md", "**/*.css", "**/*.json"],
}
